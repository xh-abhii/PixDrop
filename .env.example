# GEMINI_API_KEY: Required for Gemini AI API calls.
# The platform automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# The platform automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# CLOUDINARY CONFIGURATION:
# Log in to your Cloudinary Dashboard to find your Cloud Name.
# The user's requested API Key & Secret are provided below as placeholders.
CLOUDINARY_CLOUD_NAME="YOUR_CLOUD_NAME_HERE"
CLOUDINARY_API_KEY="254212931158241"
CLOUDINARY_API_SECRET="2qzIMv9h4mPlAfZFIBFy_rKSRjk"

